    <div class="modal__panel">
        <button type="button" onclick="closeDeviceModal()" class="icon-btn modal__close" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
        <h3 id="device-modal-title" class="modal__title">Thêm thiết bị</h3>

        <form id="form-device" class="form-grid" onsubmit="handleDeviceSubmit(event)">
            <input type="hidden" id="dev-uid" value="0">
            <div class="span-2">
                <label class="form-label" for="dev-name">Tên thiết bị <span class="req">*</span></label>
                <input type="text" id="dev-name" required class="form-control">
            </div>
            <div>
                <label class="form-label" for="dev-cat">Danh mục</label>
                <input type="text" id="dev-cat" class="form-control">
            </div>
            <div>
                <label class="form-label" for="dev-brand">Thương hiệu <span class="req">*</span></label>
                <select id="dev-brand" required class="form-control"></select>
            </div>
            <div>
                <label class="form-label" for="dev-price-orig">Giá gốc (đ)</label>
                <input type="number" id="dev-price-orig" min="0" inputmode="numeric" required class="form-control">
            </div>
            <div>
                <label class="form-label" for="dev-price-pre">Giá đặt trước (đ)</label>
                <input type="number" id="dev-price-pre" min="0" inputmode="numeric" required class="form-control">
            </div>
            <div class="span-2">
                <label class="form-label" for="dev-title-main">Tiêu đề chính</label>
                <input type="text" id="dev-title-main" class="form-control">
