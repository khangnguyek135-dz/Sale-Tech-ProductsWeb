@{
    Layout = "_AdminLayout";
}

<div class="page">

    <!-- ================= TAB 1: TỔNG QUAN ================= -->
    <div id="module-dashboard" class="admin-module">
        <div class="ledger">
            <div class="stat stat--lead">
                <p class="stat-label">Doanh thu</p>
                <p id="stat-revenue" class="stat-value">0đ</p>
                <p class="stat-note">Cập nhật mỗi khi đổi trạng thái đơn</p>
            </div>
            <div class="stat">
                <p class="stat-label">Đơn hàng</p>
                <p id="stat-orders" class="stat-value">0</p>
                <p class="stat-note">Đơn giữ suất Pre-Order</p>
            </div>
            <div class="stat">
                <p class="stat-label">Chờ xác nhận cọc</p>
                <p id="stat-pending" class="stat-value stat-value--warn">0</p>
                <p class="stat-note">Cần duyệt để giao hàng</p>
            </div>
            <div class="stat">
                <p class="stat-label">Thiết bị</p>
                <p id="stat-devices" class="stat-value">0</p>
                <p class="stat-note">Các phiên bản custom 75%</p>
            </div>
        </div>

        <div class="dash-grid">
            <div class="card">
                <div class="card-head">
                    <h3 class="card-title">Đơn hàng theo trạng thái</h3>
                    <p class="card-sub">Số đơn đang nằm ở từng bước của quy trình bán</p>
                </div>
                <div id="status-distribution-list" class="status-list"></div>
            </div>

            <div class="card">
                <div class="card-head">
                    <h3 class="card-title">Thao tác nhanh</h3>
                </div>
                <div class="action-list">
                    <button type="button" onclick="switchAdminTab('orders')" class="btn btn-primary btn--block">
                        <i class="fa-solid fa-boxes-packing"></i> Xử lý đơn hàng mới
                    </button>
                    <button type="button" onclick="openDeviceModal(0)" class="btn btn-ghost btn--block">
                        <i class="fa-solid fa-plus"></i> Thêm thiết bị
                    </button>
                    <button type="button" onclick="switchAdminTab('users')" class="btn btn-ghost btn--block">
                        <i class="fa-solid fa-user-shield"></i> Phân quyền tài khoản
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= TAB 2: ĐƠN HÀNG (DonDatHang) ================= -->
    <div id="module-orders" class="admin-module" hidden>
        <div class="toolbar">
            <div class="search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" id="order-search-input" class="form-control"
                       placeholder="Tìm theo mã đơn, số điện thoại, tên khách"
                       aria-label="Tìm đơn hàng" oninput="debouncedLoadOrders()">
            </div>
            <div class="tabs" id="order-status-tabs" role="group" aria-label="Lọc theo trạng thái">
                <button type="button" class="tab is-active" data-status-filter="ALL" onclick="filterOrderStatus('ALL', this)">Tất cả</button>
            </div>
        </div>

        <div class="card card--table">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th>Đặt lúc</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-orders-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 3: THIẾT BỊ (ThongTinThietBi) ================= -->
    <div id="module-devices" class="admin-module" hidden>
        <div class="toolbar">
            <h2 class="card-title">Bàn phím và thiết bị</h2>
            <button type="button" onclick="openDeviceModal(0)" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus"></i> Thêm thiết bị
            </button>
        </div>

        <div class="card card--table">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên thiết bị</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                            <th class="text-right">Giá gốc</th>
                            <th class="text-right">Giá đặt trước</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-devices-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 4: THƯƠNG HIỆU (ThuongHieu) ================= -->
    <div id="module-brands" class="admin-module" hidden>
        <div class="toolbar">
            <h2 class="card-title">Thương hiệu bàn phím</h2>
            <button type="button" onclick="openBrandModal('')" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus"></i> Thêm thương hiệu
            </button>
        </div>

        <div class="card card--table">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tên thương hiệu</th>
                            <th>Giới thiệu</th>
                            <th>Logo</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-brands-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 5: TRẠNG THÁI ĐƠN (TinhTrangDonHang) ================= -->
    <div id="module-statuses" class="admin-module" hidden>
        <div class="toolbar">
            <h2 class="card-title">Danh mục trạng thái đơn hàng</h2>
            <button type="button" onclick="openStatusModal('', '', 1)" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-plus"></i> Thêm trạng thái
            </button>
        </div>

        <div class="card card--table">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tên hiển thị</th>
                            <th>Thứ tự</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-statuses-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 6: ĐÁNH GIÁ (DanhGia) ================= -->
    <div id="module-reviews" class="admin-module" hidden>
        <div class="card card--table">
            <div class="card-head">
                <h2 class="card-title">Đánh giá của khách hàng</h2>
                <p class="card-sub">Xóa các đánh giá spam hoặc sai nội dung</p>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Họ và tên</th>
                            <th>Số sao</th>
                            <th>Nội dung</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-reviews-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 7: TÀI KHOẢN VÀ ROLE (TaiKhoan) ================= -->
    <div id="module-users" class="admin-module" hidden>
        <div class="card card--table">
            <div class="card-head">
                <h2 class="card-title">Tài khoản và phân quyền</h2>
                <p class="card-sub">Đổi role giữa Admin và User</p>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-users-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 8: CÀI ĐẶT (CaiDat) ================= -->
    <div id="module-settings" class="admin-module" hidden>
        <div class="card card--form">
            <div class="card-head">
                <h2 class="card-title">Thêm hoặc sửa cấu hình</h2>
                <p class="card-sub">Nhập trùng khóa sẽ ghi đè nội dung cũ</p>
            </div>
            <form id="form-save-setting" class="form-stack" onsubmit="handleSaveSettingSubmit(event)">
                <div>
                    <label class="form-label" for="set-key">Khóa cấu hình <span class="req">*</span></label>
                    <input type="text" id="set-key" required placeholder="Ví dụ: STORE_NAME" class="form-control">
                </div>
                <div>
                    <label class="form-label" for="set-content">Nội dung</label>
                    <textarea id="set-content" rows="4" placeholder="Chuỗi hoặc JSON" class="form-control"></textarea>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình
                    </button>
                </div>
            </form>
        </div>

        <div class="card card--table">
            <div class="card-head">
                <h3 class="card-title">Cấu hình hiện có</h3>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Khóa</th>
                            <th>Nội dung</th>
                            <th>Ngày tạo</th>
                        </tr>
                    </thead>
                    <tbody id="tbl-settings-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- ================= HỘP THOẠI THIẾT BỊ ================= -->
